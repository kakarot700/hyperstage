{
  "name": "@hyperstage/cli",
  "version": "2.0.0",
  "description": "HyperStage command line: init, lint, sim, export, skills install.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hyperstage": "./bin/hyperstage.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target es2022 --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperstage/core": "workspace:*",
    "@hyperstage/mcp-server": "workspace:*",
    "@hyperstage/spatial-linter": "workspace:*",
    "commander": "^14.0.0",
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
