{
  "name": "@hyperstage/core",
  "version": "1.1.0",
  "description": "HyperStage SceneAST schema, zero-DOM JSX runtime, snapTo resolver, and showcase presets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./src/index.ts", "import": "./dist/index.js" },
    "./jsx-runtime": { "source": "./src/jsx-runtime.ts", "types": "./src/jsx-runtime.ts", "import": "./dist/jsx-runtime.js" },
    "./jsx-dev-runtime": { "source": "./src/jsx-dev-runtime.ts", "types": "./src/jsx-dev-runtime.ts", "import": "./dist/jsx-dev-runtime.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/jsx-runtime.ts src/jsx-dev-runtime.ts --format esm --target es2022 --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": { "tsup": "^8.5.0" }
}
