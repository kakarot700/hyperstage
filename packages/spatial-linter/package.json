{
  "name": "@hyperstage/spatial-linter",
  "version": "1.1.0",
  "description": "Deterministic 4-pass spatial linter (E01-E04) with Rapier3D rollouts and auto-fixer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./src/index.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target es2022 --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "@hyperstage/core": "workspace:*"
  },
  "devDependencies": { "tsup": "^8.5.0" }
}
