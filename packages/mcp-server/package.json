{
  "name": "@hyperstage/mcp-server",
  "version": "1.1.0",
  "description": "Model Context Protocol stdio server exposing the HyperStage compiler, linter, simulator, and HTML exporter.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hyperstage-mcp": "./bin/hyperstage-mcp.js"
  },
  "exports": {
    ".": {
      "source": "./src/tools.ts",
      "types": "./src/tools.ts",
      "import": "./dist/tools.js"
    },
    "./html-exporter": {
      "source": "./src/html-exporter.ts",
      "types": "./src/html-exporter.ts",
      "import": "./dist/html-exporter.js"
    },
    "./three-sources": {
      "source": "./src/three-sources.ts",
      "types": "./src/three-sources.ts",
      "import": "./dist/three-sources.js"
    },
    "./server": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/html-exporter.ts src/tools.ts src/three-sources.ts --format esm --target es2022 --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperstage/core": "workspace:*",
    "@hyperstage/spatial-linter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
